<Window x:Class="BIMPlugins.ExtStorage.RevitServer.Windows.MultiRSNWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:classes="clr-namespace:BIMPlugins.ExtStorage.RevitServer.Classes"
        xmlns:converters="clr-namespace:BIMPlugins.ExtStorage.Converters"
        xmlns:local="clr-namespace:BIMPlugins.ExtStorage.RevitServer.ViewModels"
        d:DataContext="{d:DesignInstance local:MultiRSNViewModel}"
        mc:Ignorable="d"
        Height="700" Width="450" ResizeMode="NoResize" Title="Выберите проект(ы) с Revit Server" WindowStartupLocation="CenterScreen" Topmost="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme BaseTheme="Light" PrimaryColor="#f88518" SecondaryColor="#FF0052A5" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EscapeUnderscoreConverter x:Key="EscapeUnderscoreConverter" />
            <materialDesign:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible"/>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            
            <Image Source="/BIMPlugins.ExtStorage;component/Resources/search-32.png" Height="20" Width="20" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="5 0" Margin="0 5"
                     Height="22" materialDesign:HintAssist.Hint="Введите текст для фильтрации" materialDesign:TextFieldAssist.HasClearButton="True" materialDesign:HintAssist.IsFloating="False">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding FilterKeyDownCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <materialDesign:PackIcon Grid.Column="2" Kind="InformationOutline" Height="22" Width="22" Margin="5" Padding="0" ToolTipService.InitialShowDelay="10" Foreground="#CC000000">
                <materialDesign:PackIcon.ToolTip>
                    <TextBlock Text="Синтаксис регулярных выражений&#xa;^ - соответствие должно начинаться в начале строки&#xa;$ - конец строки&#xa;. - знак точки определяет любой одиночный символ&#xa;* - предыдущий символ повторяется 0 и более раз&#xa;+ - предыдущий символ повторяется 1 и более раз&#xa;? - предыдущий символ повторяется 0 или 1 раз&#xa;&#xa;Пример: выражение м.р соответствует слову мир или мор,&#xa;выражение ^Гл.*К1 соответствует проектам начинающихся на Гл и содержащих К1"
                        FontSize="14"/>
                </materialDesign:PackIcon.ToolTip>
            </materialDesign:PackIcon>
        </Grid>

        <Button Panel.ZIndex="1" Width="25" Height="25" Padding="0" Margin="5 0 25 -35" Command="{Binding ResetAllExpandedCommand}" CommandParameter="{Binding ServerItems}"
                HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Свернуть все">
            <materialDesign:PackIcon Kind="ArrowCollapse" Width="25" Height="25" Foreground="#CC000000"/>
        </Button>
        <Border Margin="5" Padding="0" BorderThickness="1" BorderBrush="#f88518">
            <TreeView Panel.ZIndex="0" ItemsSource="{Binding ServerItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="450" MaxHeight="450"
                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" Margin="0" Padding="0" 
                      ScrollViewer.VerticalScrollBarVisibility="Visible">
                <!--<b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectedItemChanged">
                        <b:InvokeCommandAction Command="{Binding TreeItemClickedCommand}" 
                    CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>-->

                <TreeView.Resources>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                        <Setter Property="Padding" Value="2 0"/>
                        <Setter Property="Margin" Value="0"/>

                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    </Style>

                    <HierarchicalDataTemplate DataType="{x:Type classes:FolderItem}" ItemsSource="{Binding Items}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Height="20" Width="20" VerticalAlignment="Center" Foreground="#CC000000">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServer}" Value="true">
                                                <Setter Property="Kind" Value="IpOutline"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsServer}" Value="false">
                                                <Setter Property="Kind" Value="FolderOutline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <Label Content="{Binding Name, Converter={StaticResource EscapeUnderscoreConverter}}" Height="23"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type classes:FileItem}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="2 0" Height="23"
                                      Content="{Binding Name, Converter={StaticResource EscapeUnderscoreConverter}}"
                                      Command="{Binding DataContext.ProjectCheckedCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <Border Margin="5 0" Padding="0" BorderThickness="1" BorderBrush="#f88518">
            <ListBox ItemsSource="{Binding Projects}" SelectionMode="Single" Height="125" MaxHeight="125">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="5 2" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <Button Style="{StaticResource MaterialDesignPaperButton}" Content="Готово" Margin="5" Height="25" Padding="0"/>
    </StackPanel>
</Window>
