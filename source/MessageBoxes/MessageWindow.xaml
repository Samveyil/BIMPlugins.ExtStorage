<Window x:Class="BIMPlugins.ExtStorage.MessageBoxes.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:BIMPlugins.ExtStorage.MessageBoxes"
        d:DataContext="{d:DesignInstance local:MessageViewModel}"
        mc:Ignorable="d"
        Title="SE Plugins" MinHeight="150" MinWidth="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Topmost="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme BaseTheme="Light" PrimaryColor="#f88518" SecondaryColor="#FF0052A5" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <materialDesign:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter" />
            <materialDesign:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <materialDesign:BooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Padding="5">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="{Binding Image}" Margin="5" Height="35" Width="35" Foreground="#f88518"
                                         Visibility="{Binding Image, Converter={StaticResource NullableToVisibilityConverter}}"/>
                <TextBlock Text="{Binding MessageText}" Margin="5" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="300"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        Visibility="{Binding UseOKButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Margin="5 10 5 5" Content="ОК" Padding="30 0" Height="25" Style="{StaticResource MaterialDesignPaperButton}"
                        Command="{Binding CloseCommand}" CommandParameter="ОК"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        Visibility="{Binding UseOKButton, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                <Button Margin="5 10 25 5" Content="Да" Padding="30 0" Height="25" Style="{StaticResource MaterialDesignPaperButton}"
                        Command="{Binding CloseCommand}" CommandParameter="Да"/>
                <Button Margin="25 10 5 5" Content="Нет" Padding="30 0" Height="25" Style="{StaticResource MaterialDesignPaperButton}"
                        Command="{Binding CloseCommand}" CommandParameter="Нет"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
